# ==============================================================================
# ENVIRONMENT VARIABLES - WARUNG PRAPATAN (CAPSTONE 2)
# ==============================================================================

# Supabase (PostgreSQL Cloud Backend)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot API
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Groq API (LLM Llama untuk AI Agent)
# Dapatkan dari https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Secret Key untuk Session Dashboard
SESSION_SECRET=warung-prapatan-capstone-secret-key-2026-super-secure

# App Base URL (untuk Webhook Telegram)
NEXT_PUBLIC_APP_URL=http://localhost:3000
